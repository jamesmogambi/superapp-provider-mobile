# ── Shared environment variables ────────────────────────────────────────
# Loaded in ALL environments. Values here are the fallback/default and are
# OVERRIDDEN by .env.development (dev) and .env.production (prod).
#
# Keep environment-specific values (Clerk keys, API URLs) in those files,
# NOT here — anything set here also applies to production.
#
# Only EXPO_PUBLIC_* variables are exposed to the app bundle.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PRODUCTION_KEY

# Backend API base URL (placeholder — update when backend integration lands).
EXPO_PUBLIC_API_URL=https://api.foxjek.example.com

# Cloudinary Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_API_KEY=
EXPO_PUBLIC_CLOUDINARY_API_SECRET=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
