# ── Production environment ──────────────────────────────────────────────
# Loaded automatically for production builds (`expo export`, EAS build
# production profile). Overrides values in .env.

# Clerk — Production instance.
# Replace with your pk_live_ key after enabling the Production instance in
# the Clerk Dashboard (a custom domain + DNS setup is required for prod).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PRODUCTION_KEY

# Backend API base URL (placeholder — update when backend integration lands).
EXPO_PUBLIC_API_URL=https://api.foxjek.example.com
