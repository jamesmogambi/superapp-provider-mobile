# ── Environment variables template ──────────────────────────────────────
# Copy the relevant values into:
#   .env.development  → used by `expo start`
#   .env.production   → used by production builds
#   .env.local        → your personal overrides (git-ignored, never committed)
#
# Rules:
#   • Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
#   • Clerk *publishable* keys are public and safe to commit.
#   • NEVER put a Clerk SECRET key in this app — it must not ship to a client.

# Clerk publishable key (Dashboard → API Keys)
#   development → pk_test_...
#   production  → pk_live_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend API base URL
EXPO_PUBLIC_API_URL=
